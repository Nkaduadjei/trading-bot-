# Names only. Copy to .env and fill in. .env is git-ignored. Never commit real values.
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trading
BROKER_API_KEY=
BROKER_API_SECRET=
TRADING_MODE=paper
# Auth service. Generate real values with: python scripts/gen_secrets.py >> .env
JWT_SECRET=
KEY_ENCRYPTION_KEY=
# DATABASE_URL=sqlite:///./auth.db
# Trading services. Created for you by: python scripts/gen_secrets.py --fill .env
APPROVAL_KEY=
EXECUTION_TOKEN=
RISK_TOKEN=
# EXECUTION_URL=http://127.0.0.1:8002
# Who may place orders through the gateway (comma-separated emails). Empty means NOBODY can trade.
TRADER_EMAILS=
# Admin console. AUTH_ADMIN_TOKEN is created by: python scripts/gen_secrets.py --fill .env
AUTH_ADMIN_TOKEN=
# Who may use the admin console (comma-separated emails). Empty means NOBODY can.
ADMIN_EMAILS=
# Execution history database. Default is a local SQLite file; a PostgreSQL URL works later.
# EXECUTION_DB_URL=sqlite:///./execution.db
# Starting cash of the paper account. Fixed the FIRST time the service runs, then remembered.
# PAPER_START_CASH=100000
